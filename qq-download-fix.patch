+        """把 QQ 私有图片 CDN 链接换成本地文件。
+
+        NapCat / LLOneBot 在处理部分群图片时会给出
+        ``https://gchat.qpic.cn/download?appid=...&fileid=...`` 这类需要
+        QQ 登录态的链接，第三方直接 GET 会得到 HTTP 400。此时改走
+        OneBot 的 ``get_image`` 接口，让协议端把图片落盘或返回 base64。
+        """
+        url = getattr(component, "url", "") or ""
+        if not url or "gchat.qpic.cn/download" not in url:
+            return component
+
+        file_ref = (
+            data.get("file")
+            or data.get("file_id")
+            or data.get("filename")
+            or ""
+        )
+        if not file_ref:
+            return component
+
+        ret = None
+        attempts = [
+            ("get_image", {"file": file_ref}),
+            ("get_image", {"file_id": file_ref}),
+            ("get_image", {"id": file_ref}),
+            ("get_file", {"file_id": file_ref}),
+            ("get_file", {"file": file_ref}),
+        ]
+        for action, params in attempts:
+            try:
+                ret = await self.bot.call_action(action=action, **params)
+            except ActionFailed as exc:
+                logger.debug(f"[QQ图片] {action}{params} 调用失败: {exc}")
+                continue
+            except BaseException as exc:  # noqa: BLE001
+                logger.debug(f"[QQ图片] {action}{params} 调用异常: {exc}")
+                continue
+            if isinstance(ret, dict) and (ret.get("file") or ret.get("url")):
+                break
+
+        if not isinstance(ret, dict):
+            return component
+
+        # 优先使用协议端返回的公开 url
+        new_url = ret.get("url")
+        if isinstance(new_url, str) and new_url.startswith("http"):
+            component.url = new_url
+            return component
+
+        file_value = ret.get("file")
+        if not isinstance(file_value, str) or not file_value:
+            return component
+
+        path = ""
+        if file_value.startswith("base64://"):
+            try:
+                import base64 as _base64
+
+                raw = _base64.b64decode(file_value[len("base64://") :])
+                path = save_temp_img(raw)
+            except Exception as exc:  # noqa: BLE001
+                logger.debug(f"[QQ图片] base64 落盘失败: {exc}")
+        elif file_value.startswith("file://"):
+            path = file_value[len("file://") :]
+        elif os.path.exists(file_value):
+            path = file_value
+
+        if path and os.path.exists(path):
