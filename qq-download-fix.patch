+    def _image_candidates(self) -> list[str]:
+        """按「本地文件优先、网络 URL 兜底」的顺序返回可用的图片引用。
+
+        QQ 适配器有时同时给出本地缓存路径（``path`` / ``file``）和会过期的
+        ``url``；优先使用本地文件可以避免图片 CDN 返回 400 导致获取失败。
+        """
+        local: list[str] = []
+        remote: list[str] = []
+        for ref in (self.path, self.file, self.url):
+            if not isinstance(ref, str) or not ref:
+                continue
+            if ref in local or ref in remote:
+                continue
+            if ref.startswith(("http://", "https://", "base64://", "data:")):
+                remote.append(ref)
+            elif ref.startswith("file://") or os.path.exists(ref):
+                local.append(ref)
+            else:
+                remote.append(ref)
+        return local + remote
+
